# Copy to .env.local and fill in. Never commit .env.local.
# Variables prefixed NEXT_PUBLIC_ are sent to the browser: never put secrets in them.

# Public site URL. Used for canonical links, sitemap, Open Graph tags and the links inside
# auth emails (confirm, reset). Must match an allowed redirect URL in Supabase Auth settings.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (required for sign-in and data) ---
# Local: run `pnpm db:start`, then copy API URL and Publishable key from `pnpm exec supabase status`.
# Hosted: Project Settings → API. A legacy "anon" key also works here.
# Never put the secret / service_role key in any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional social sign-in: comma-separated Supabase provider ids. Supported: google, github,
# azure (Microsoft), slack_oidc (Slack). Enable each provider in Supabase first (docs/AUTH_SETUP.md).
# Example: NEXT_PUBLIC_AUTH_PROVIDERS=google,github
NEXT_PUBLIC_AUTH_PROVIDERS=

# Optional: shows "Source" links in the footer when set.
NEXT_PUBLIC_REPO_URL=

# Optional: enables the footer "Contact" link (mailto:).
NEXT_PUBLIC_CONTACT_EMAIL=

# @module:email
# --- Email (server-only; never NEXT_PUBLIC_) ---
# resend | smtp | log. "log" (default) sends nothing and prints only the subject.
EMAIL_TRANSPORT=log
# Required for resend and smtp, e.g. "Your App <hello@yourdomain.com>" (a domain you've verified).
EMAIL_FROM=
RESEND_API_KEY=
# SMTP works with SendGrid, Mailgun, Postmark, SES, etc. Port 465 = TLS, 587 = STARTTLS.
# Local Mailpit: SMTP_HOST=127.0.0.1 SMTP_PORT=54325 (no user/password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# @end:email

# @module:analytics
# --- Analytics (optional) ---
# Plausible is cookieless: loads without a consent banner.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional self-hosted Plausible script URL.
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=
# Google Analytics 4 (G-XXXXXXX). Sets cookies, so it only loads after the visitor accepts the banner.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# @end:analytics
