# Copy to .env.local and fill in. Never commit .env.local.
# Variables prefixed NEXT_PUBLIC_ are sent to the browser: never put secrets in them.

# Public site URL, used for canonical links, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: shows "Source" links in the footer when set.
NEXT_PUBLIC_REPO_URL=

# Optional: enables the footer "Contact" link (mailto:).
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Supabase (added in milestone C2; not used yet) ---
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
